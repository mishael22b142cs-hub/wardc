{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/cron/(.*)", "destination": "/api/cron/$1" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/job-scrape", "schedule": "0 2 * * *" },
    { "path": "/api/cron/medicine-reminders", "schedule": "0 3 * * *" },
    { "path": "/api/cron/booking-timeout", "schedule": "0 1 * * *" }
  ]
}
